# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
# Start the mock vendor-risk API automatically when nothing is listening on localhost (1/0)
AUTO_START_MOCK_API=1

# LLM provider: auto | kiro | rules
#   auto  -> Kiro CLI if installed and KIRO_API_KEY is set, otherwise deterministic rules only
#   rules -> no model; the app still works end to end
LLM_PROVIDER=auto
MODEL_NAME=claude-haiku-4.5

# Kiro API key (create at https://app.kiro.dev -> API Keys; requires a Kiro Pro+ subscription)
# Install the CLI: curl -fsSL https://cli.kiro.dev/install | bash
KIRO_API_KEY=
